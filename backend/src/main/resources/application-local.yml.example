# Copy this file to application-local.yml (same directory) and fill in your
# own local values. application-local.yml is gitignored and must never be
# committed with real credentials.
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/recruitment_system?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
    username: your_mysql_username
    password: your_mysql_password
    driver-class-name: com.mysql.cj.jdbc.Driver

app:
  jwt:
    # Generate your own, e.g.: openssl rand -base64 64
    secret: replace-with-a-long-random-base64-encoded-secret-at-least-256-bits
    expiration-ms: 86400000
  cors:
    allowed-origins: http://localhost:5173
  upload:
    dir: uploads
